<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:WorkTimeTracker.App.Converters"
             x:Class="WorkTimeTracker.App.App"
             Name="WorkTime Tracker"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://WorkTimeTracker/Styles/Theme.axaml" />
        <ResourceInclude Source="avares://WorkTimeTracker/Styles/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <conv:ResourceKeyToGeometryConverter x:Key="IconConverter" />
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#4F46E5" RegionColor="#F5F6FA" />
        <ColorPaletteResources x:Key="Dark" Accent="#6366F1" RegionColor="#131418" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://WorkTimeTracker/Styles/AppStyles.axaml" />
  </Application.Styles>
</Application>
