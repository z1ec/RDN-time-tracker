<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:WorkTimeTracker.App.Views"
        xmlns:vm="using:WorkTimeTracker.App.ViewModels"
        x:Class="WorkTimeTracker.App.Views.EditEntryWindow"
        x:DataType="vm:EntryEditorViewModel"
        Title="{Binding Title}"
        Icon="avares://WorkTimeTracker/Assets/app.ico"
        SizeToContent="WidthAndHeight" CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBackgroundBrush}">
  <Window.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding $parent[views:EditEntryWindow].CancelCommand}" />
  </Window.KeyBindings>
  <StackPanel Margin="24" Spacing="12" Width="460">
    <TextBlock Classes="h2" FontSize="18" Text="{Binding Title}" />
    <TextBlock Classes="subtle" Text="{Binding Hint}" TextWrapping="Wrap" IsVisible="{Binding HasHint}" />
    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
      <StackPanel Spacing="4">
        <TextBlock Classes="subtle small" Text="Дата" />
        <CalendarDatePicker SelectedDate="{Binding Date}" DisplayDateEnd="{Binding MaxDate.Date}" HorizontalAlignment="Stretch"
                            SelectedDateFormat="Custom" CustomDateFormatString="dd.MM.yyyy" AutomationProperties.Name="Дата" />
      </StackPanel>
      <StackPanel Grid.Column="1" Spacing="4">
        <TextBlock Classes="subtle small" Text="Начало" />
        <TimePicker ClockIdentifier="24HourClock" MinuteIncrement="1" SelectedTime="{Binding Start}" MinWidth="0" HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Начало" />
      </StackPanel>
      <StackPanel Grid.Column="2" Spacing="4">
        <TextBlock Classes="subtle small" Text="Конец" />
        <TimePicker ClockIdentifier="24HourClock" MinuteIncrement="1" SelectedTime="{Binding End}" MinWidth="0" HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Конец" />
      </StackPanel>
    </Grid>
    <StackPanel Spacing="4">
      <TextBlock Classes="subtle small" Text="Комментарий" />
      <TextBox Text="{Binding Comment}" MaxLength="500" AcceptsReturn="False" AutomationProperties.Name="Комментарий" />
      <TextBlock Classes="subtle small" HorizontalAlignment="Right" Text="{Binding CommentCounter}" />
    </StackPanel>
    <TextBlock FontWeight="SemiBold" Text="{Binding DurationText}" />
    <TextBlock Classes="error" Text="{Binding Error}" TextWrapping="Wrap"
               IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Content="Отмена" Command="{Binding $parent[views:EditEntryWindow].CancelCommand}" AutomationProperties.Name="Отмена" />
      <Button Classes="accent" Content="Сохранить" IsDefault="True" IsEnabled="{Binding CanSave}"
              Command="{Binding $parent[views:EditEntryWindow].SaveCommand}" AutomationProperties.Name="Сохранить" />
    </StackPanel>
  </StackPanel>
</Window>
