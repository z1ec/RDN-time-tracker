<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WorkTimeTracker.App.ViewModels"
             x:Class="WorkTimeTracker.App.Views.AboutView"
             x:DataType="vm:AboutViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24,20,24,24" Spacing="16" MaxWidth="760" HorizontalAlignment="Left">
      <TextBlock Classes="h1" Text="О программе" />
      <Border Classes="card" Padding="24">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="24">
          <Image Source="avares://WorkTimeTracker/Assets/icon-256.png" Width="96" Height="96" VerticalAlignment="Top" />
          <StackPanel Grid.Column="1" Spacing="8">
            <TextBlock Classes="h1" Text="{Binding Title}" />
            <TextBlock Classes="subtle" Text="{Binding Version}" AutomationProperties.Name="Версия" />
            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,8,0,0" />
            <TextBlock Classes="subtle" Text="{Binding Privacy}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
              <Button Command="{Binding OpenRepositoryCommand}" AutomationProperties.Name="Открыть репозиторий">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Data="{StaticResource IconLink}" />
                  <TextBlock Text="Репозиторий на GitHub" />
                </StackPanel>
              </Button>
              <Button Command="{Binding OpenDataFolderCommand}" AutomationProperties.Name="Открыть папку данных">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Data="{StaticResource IconFolderOpen}" />
                  <TextBlock Text="Папка данных" />
                </StackPanel>
              </Button>
            </StackPanel>
            <SelectableTextBlock Classes="subtle" Text="{Binding RepositoryUrl}" Margin="0,8,0,0" />
            <SelectableTextBlock Classes="subtle" Text="{Binding DataDirectory}" TextWrapping="Wrap" />
            <TextBlock Classes="subtle small" Text="{Binding License}" TextWrapping="Wrap" Margin="0,8,0,0" />
          </StackPanel>
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
