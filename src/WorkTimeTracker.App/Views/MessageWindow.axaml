<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:WorkTimeTracker.App.Views"
        x:Class="WorkTimeTracker.App.Views.MessageWindow"
        Title="WorkTime Tracker"
        Icon="avares://WorkTimeTracker/Assets/app.ico"
        SizeToContent="Height" Width="520" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBackgroundBrush}">
  <Window.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding $parent[views:MessageWindow].CloseCommand}" />
  </Window.KeyBindings>
  <StackPanel Margin="24" Spacing="12">
    <StackPanel Orientation="Horizontal" Spacing="12">
      <PathIcon Data="{StaticResource IconErrorCircle}" Width="24" Height="24" Foreground="{DynamicResource ErrorBrush}" />
      <TextBlock x:Name="HeaderText" Classes="h2" FontSize="18" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="440" />
    </StackPanel>
    <SelectableTextBlock x:Name="MessageText" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button x:Name="OpenFolderButton" Content="Открыть папку" AutomationProperties.Name="Открыть папку" />
      <Button Classes="accent" Content="Закрыть" IsDefault="True" Command="{Binding $parent[views:MessageWindow].CloseCommand}" AutomationProperties.Name="Закрыть" />
    </StackPanel>
  </StackPanel>
</Window>
